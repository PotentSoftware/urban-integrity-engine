# UrbanIntegrity demo — Caddy ingress.
#
# Rendered by scripts/deploy-demo.sh. @@DOMAIN@@ and @@BASICAUTH@@ are substituted;
# do not edit the rendered copy on the server, it is overwritten on every deploy.
#
# This is the ONLY thing listening on a public interface. SurrealDB (:8000) and the
# workbench (:8090) both bind 127.0.0.1 and are unreachable except through here.

{
	# Contact address for Let's Encrypt expiry notices.
	email @@ACME_EMAIL@@

	# No admin API on a box whose whole job is to be exposed.
	admin off
}

@@DOMAIN@@ {
	encode zstd gzip

	# Every viewer gets their own credential so access can be revoked individually
	# and the access log says who looked. Generated by `caddy hash-password`.
	basic_auth {
@@BASICAUTH@@
	}

	# This is a demonstration of an anti-corruption tool running on a synthetic
	# fixture. It must never be indexed, archived, or scraped into a training set
	# where its output could be mistaken for findings about real people.
	header {
		X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	respond /robots.txt 200 {
		body "User-agent: *
Disallow: /
"
	}

	reverse_proxy 127.0.0.1:8090 {
		# The workbench replays the corpus at boot; give it room to come up before
		# a viewer's first request is failed.
		transport http {
			dial_timeout 10s
			response_header_timeout 120s
		}
	}

	log {
		output file /var/log/caddy/urban-demo.log {
			roll_size 10MiB
			roll_keep 5
		}
		# Basic-auth usernames appear in the log. That is the point — it is the
		# record of who was shown what, and when.
		format json
	}
}
