# Copy to `.env` (gitignored) at the repo root. It is read by `dotenv` before environment
# variables are processed. Note the DOUBLE underscore after URBAN — the loader's prefix is
# `URBAN__`, and a single underscore is silently ignored.
#
# Nothing below is needed to build, run the tests, or run the planted toy analysis
# (scripts/toy-analysis.sh). See docs/GETTING-STARTED.md (step A7) and docs/CONFIGURATION.md.

# SurrealDB credentials — must match the running server (scripts/surreal-start.sh uses root/root).
URBAN__SURREAL__USERNAME=root
URBAN__SURREAL__PASSWORD=root

# Companies House STREAMING API key — used by `serve` only.
# URBAN__INGEST__CH_API_KEY=

# Companies House REST API key — backfill, the CH enricher adapters, the Python CH scripts.
# Not interchangeable with the streaming key.
# URBAN__ENRICHER__CH__API_KEY=

# HM Land Registry key — CCOD/OCOD adapters.
# URBAN__ENRICHER__LAND_REGISTRY__API_KEY=

# Optional Firecrawl fallback for planning portals.
# URBAN__INGEST__FIRECRAWL_API_KEY=
