# Rust build artefacts
/target/
**/*.rs.bk

# Trunk build output (Phase 42, D-14) — never committed; scripts/build-workbench.sh is the sole
# entry point that produces it. Trunk.toml routes the frontend crate's output directly into
# crates/workbench/dist/ (not crates/workbench-web/dist/) so plan 42-05's rust-embed folder
# attribute reads it with no separate copy step. Both paths are listed explicitly (the generic
# `dist/` rule above already covers them, but D-14 asks for this to be self-documenting here).
/crates/workbench/dist/
/crates/workbench-web/dist/

# Cosmograph shim build tool (Phase 42, D-16) — a one-shot local build directory, not a Cargo
# concern. package.json/package-lock.json ARE committed for reproducibility; node_modules/ is
# never committed. The bundled OUTPUT (crates/workbench-web/js/cosmograph-shim.js) IS committed —
# it is the vendored, pinned artifact this whole gitignore entry exists to keep node_modules/ out
# of the way of.
/crates/workbench-web/js-build/node_modules/

# Timestamped GraphML exports (scripts/export_graphml.sh) — generated artefacts
/urban-integrity-*.graphml

# Rendered evidence-report exports + ad-hoc memo deliverables (kept on disk, not
# in git). The source evidence-report.md IS tracked — only the rendered exports
# are ignored.
/evidence-report.html
/evidence-report.jpeg
/evidence-report.pdf
/evidence-report.png
/valuation-memo.pdf
/procurement-integrity-briefing.pdf

# Cargo lock — keep for workspace (reproducible builds)
# Cargo.lock  # intentionally tracked

# Environment
.env
.env.local

# Operator's real analysis config. The committed config.toml is a fictional example; copy it
# to config.local.toml and edit that for a real analysis. When config.local.toml exists,
# AppConfig::load() reads it INSTEAD of config.toml (see docs/CONFIGURATION.md). It names
# real wards, planning portals and the operator's analysis database, so it is never committed.
/config.local.toml

# Python virtualenv — NEVER commit this
.venv/
venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# Scrapling sidecar Python cache
services/scrapling-sidecar/__pycache__/
services/**/__pycache__/

# Graphify generated output (regenerated automatically on each commit)
graphify-out/cache/
graphify-out/.graphify_root
graphify-out/graph.json
graphify-out/graph.html
graphify-out/GRAPH_REPORT.md
.planning/graphs/graph.json
.planning/graphs/graph.html
.planning/graphs/GRAPH_REPORT.md
.planning/graphs/.last-build-snapshot.json
# graph.json + GRAPH_REPORT.md are regenerated by the graphify hook on every
# commit/branch-switch, so they were perpetual `git status` churn when tracked.
# Untracked (git rm --cached) and left ignored above — they live on disk locally
# and are rebuilt by the hook / `graphify update .`.

# OS artefacts
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.idea/
.vscode/settings.json
*.iml

# Data directories (checkpoints, WAL, etc.)
# Ignore data/ contents (not the dir itself) so committed reference tables can be
# re-included below — git cannot re-include a file under a wholly-excluded dir.
data/*
# …except committed reference tables loaded via include_str! / runtime read.
!data/country_incorporation_canonical.json
!data/formation_agent_postcodes.txt
*.checkpoint
*.checkpoint.tmp

# SurrealDB local data
surreal.db/
*.surql.log

# Secrets
*.pem
*.key
*.crt
companies-house.txt

# Tool scratch dirs (Serena MCP cache, Firecrawl search dumps)
.serena/
.firecrawl/

# Claude Code / Cowork per-machine state (not shared across clones)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Graphify: newer generated outputs + dated curated-graph backups the hook writes
# (siblings of the already-ignored graph.json / GRAPH_REPORT.md — all regenerated).
graphify-out/manifest.json
graphify-out/.graphify_labels.json
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# SurrealQL scratch history — per-session churn, not a source artefact.
# Uncomment to stop tracking (then: git rm --cached history.txt).
# history.txt
history.txt
.planning/tmp/

# Timestamped graph exports (scripts/export_parquet.sh, scripts/export_graphml.sh).
# Regenerable from the live analysis; large and dated, so never source.
/urban-integrity-*.graphml
/urban-integrity-nodes-*.parquet
/urban-integrity-links-*.parquet

# Brainstorming visual-companion sessions (superpowers)
/.superpowers/

# Real-world evidence report (names real people) — kept on disk, never committed
evidence-report.md
